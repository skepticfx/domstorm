{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dom-lab",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-28",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dom-lab.skepticfx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
